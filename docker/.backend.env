## Logging: LOG_FORMAT text|json, LOG_LEVEL debug|info|warn|error
LOG_FORMAT=text
LOG_LEVEL=debug

## Zoho CRM (https://api-console.zoho.eu/)
ZOHO_SYNC_ENABLED=false
# You can leave the rest empty if ZOHO_SYNC_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BASE_URL=https://www.zohoapis.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu

## OIDC
# Adjust OIDC values for the production setup. Current values match the development Keycloak instance included in the docker-compose file.
OIDC_ISSUER_URL=http://localhost:8090/realms/bbook
OIDC_DISCOVERY_URL=http://bbook-keycloak:8080/realms/bbook
OIDC_INSECURE_SKIP_ISSUER_VALIDATION=true
OIDC_CLIENT_ID=bbook
OIDC_CLIENT_SECRET=bbook-dev-secret
OIDC_REDIRECT_URL=https://localhost/auth/callback
OIDC_REQUIRED_GROUP=bbook-users


## Session secret
# Must be at least 32 characters
# openssl rand -hex 16
SESSION_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
