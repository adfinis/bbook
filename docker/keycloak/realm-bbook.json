{
  "realm": "bbook",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "groups": [
    {
      "name": "bbook-users"
    }
  ],
  "clients": [
    {
      "clientId": "bbook",
      "name": "bbook backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bbook-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost/*",
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:8081"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://localhost/*##http://localhost:8081/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@bbook.localhost",
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-bbook"],
      "groups": ["/bbook-users"]
    },
    {
      "username": "outsider",
      "enabled": true,
      "emailVerified": true,
      "email": "outsider@bbook.localhost",
      "firstName": "Out",
      "lastName": "Sider",
      "credentials": [
        {
          "type": "password",
          "value": "outsider",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-bbook"]
    }
  ]
}
