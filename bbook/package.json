{
  "name": "bbook-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:js": "esbuild node_modules/htmx.org/dist/htmx.js --minify --outfile=static/assets/htmx.js && esbuild node_modules/qrcode-generator/qrcode.js --minify --outfile=static/assets/qrcode.js",
    "build:css": "tailwindcss -i tailwind.input.css -o static/assets/tailwind.css --minify",
    "build": "npm run build:js && npm run build:css"
  },
  "dependencies": {
    "htmx.org": "2.0.10",
    "qrcode-generator": "1.5.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2"
  }
}
